                },
                {
                  "type": "text",
                  "id": "Ph59H",
                  "name": "Titre",
                  "fill": "$color/text/primary",
                  "textGrowth": "fixed-width",
                  "width": 900,
                  "content": "Voiture importée : AVDT, RTI ou rien, ce que la carte grise étrangère décide",
                  "fontFamily": "$font/family/display",
                  "fontSize": 52,
                  "fontWeight": "$font/weight/display",
                  "letterSpacing": -1.56
                },
                {
                  "type": "text",
                  "id": "le2yd",
                  "name": "Chapeau",
                  "fill": "$color/text/primary",
                  "textGrowth": "fixed-width",
                  "width": 760,
                  "content": "Pour obtenir une carte grise française, une voiture achetée en Allemagne, en Belgique ou aux Pays-Bas suit l'une de trois voies : aucune démarche préalable, une AVDT, ou une RTI. La voie se lit sur la carte grise étrangère, en deux temps : une rubrique d'abord, quinze ensuite.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font/family/body",
                  "fontSize": "$font/size/intro",
                  "fontWeight": "$font/weight/body"
                },
                {
                  "type": "frame",
                  "id": "YZQLj",
