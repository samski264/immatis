                          "id": "T8cnB",
                          "name": "Question",
                          "fill": "$color/text/primary",
                          "textGrowth": "fixed-width",
                          "width": 320,
                          "content": "Comment le malus est-il calculé ?",
                          "lineHeight": 1.3,
                          "fontFamily": "$font/family/body",
                          "fontSize": "$font/size/intro",
                          "fontWeight": "$font/weight/body"
                        },
                        {
                          "type": "text",
                          "id": "pg0Ts",
                          "name": "Réponse",
                          "fill": "$color/text/primary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Malus CO₂ sur V.7 et taxe au poids sur G, au barème de l'année de première immatriculation, puis une décote d'ancienneté de 3 % à 100 % selon l'âge. Avant 2015 ou après quinze ans : exonéré. Un champ absent n'est jamais deviné.",
                          "lineHeight": 1.45,
                          "fontFamily": "$font/family/body",
                          "fontSize": "$font/size/body",
                          "fontWeight": "$font/weight/body"
                        }
                      ]
                    },
